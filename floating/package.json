{
  "name": "floating",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --env-file=.env --import tsx src/index.ts",
    "login": "node --env-file=.env --import tsx src/login.ts",
    "send": "node --env-file=.env --import tsx src/send-hello.ts",
    "dev": "node --env-file=.env --import tsx --watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "spectrum-ts": "^12.8.0"
  },
  "devDependencies": {
    "typescript": "^7",
    "@types/node": "^22",
    "tsx": "^4"
  },
  "description": "Optional Photon messaging companion for Floating Brain",
  "engines": {
    "node": ">=22.13.0"
  }
}
